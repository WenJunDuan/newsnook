<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mirror the night startup palette without introducing a second launch layout. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#0E0F12</item>
        <item name="android:windowBackground">#0E0F12</item>
        <item name="android:colorBackground">#0E0F12</item>
        <item name="windowSplashScreenBackground">#0E0F12</item>
        <item name="windowSplashScreenIconBackgroundColor">#0E0F12</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
